# Local development settings. Copy to .env.local (git-ignored) and adjust:
#   cp .env.sample .env.local
# Loaded automatically by the app when running locally; never used on AWS.

IS_LOCAL=true

# Local PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123
POSTGRES_NAME=helpdesk_dev

# Any long random string is fine locally
JWT_SECRET=local-dev-only-secret-0123456789abcdef

# Demo users (all with password Password123) + buildings/floors/seats on startup
SEED_DEMO_DATA=true

# Only used if no admin exists (e.g. SEED_DEMO_DATA=false)
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123
